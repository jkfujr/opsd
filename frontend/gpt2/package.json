    "react-router": "8.5.0",
    "recharts": "2.15.4",
    "@tanstack/react-query": "5.105.0",
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
