{
  "name": "@opsd/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5184 --strictPort",
    "backend": "npm --prefix .. run dev:backend",
    "generate": "npm --prefix .. run generate",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5184 --strictPort",
    "package": "vite build && node scripts/package-theme.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@tanstack/react-query": "5.105.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "0.546.0",
    "motion": "^12.23.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fflate": "^0.8.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
